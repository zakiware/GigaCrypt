{
  "name": "gigacrypt",
  "version": "1.0.0",
  "description": "Simple and secure file & folder encryption for Windows with warm amber aesthetic",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --target=node22 --external:electron --external:@aws-sdk/client-s3 --outfile=dist/main/main.js && node -e \"require('fs').copyFileSync('src/main/quickLock.html', 'dist/main/quickLock.html')\"",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --target=node22 --external:electron --outfile=dist/preload/preload.js",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "dev:main": "npm run build:main && npm run build:preload && electron .",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && npm run build:main && npm run build:preload && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-packager . GigaCrypt --platform=win32 --arch=x64 --icon=icon.ico --out=dist-exe --overwrite --prune=true --asar.unpack=\"**/*.mp4\"",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "keywords": [
    "encryption",
    "aes-256-gcm",
    "vault",
    "security",
    "electron",
    "privacy"
  ],
  "author": "GigaCrypt Team",
  "license": "MIT",
  "build": {
    "appId": "com.gigacrypt.vault",
    "productName": "GigaCrypt",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "installer/vc_redist.x64.exe",
        "to": "installer/vc_redist.x64.exe"
      },
      {
        "from": "icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "tray.png",
        "to": "tray.png"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "GigaCrypt",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "installer/installer.nsh",
      "artifactName": "GigaCrypt-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/archiver": "^8.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
